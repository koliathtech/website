# Frontend (Vite)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# API origin used by referral tracking and rewards clients (no trailing /api).
# Local `vite` / `npm run dev`: leave empty to use the Vite proxy.
# Production `npm run build`: required https:// origin, e.g. https://koliath.in
# Never set this to localhost in production — the build will fail.
VITE_API_BASE=
