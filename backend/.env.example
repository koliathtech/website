# Server
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mydb

# Google OAuth Web Client ID (must match frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Shared secret for trusted app backends posting qualification events.
# Required when NODE_ENV=production (backend will not boot without it).
APP_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,https://koliath.in,https://www.koliath.in
